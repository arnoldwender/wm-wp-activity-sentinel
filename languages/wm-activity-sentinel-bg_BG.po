msgstr "Notice / Warning"

#: includes/class-sentinel-admin.php:1587
msgid "Exporte & Dateieditor"
msgstr "Експорти и файлов редактор"

#: includes/class-sentinel-admin.php:1588
msgid ""
"Aufruf von export.php, load-plugin-editor.php und load-theme-editor.php "
"(Warning); export_wp, wp_ajax_edit-theme-plugin-file, updraft_backup_started "
"und duplicator_backup_started (Critical)"
msgstr ""
